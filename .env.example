# Copia questo file in ".env" e inserisci la tua chiave Tavily (1000 ricerche/mese gratuite).
# Ottienila su: https://app.tavily.com
TAVILY_API_KEY=

# --- Opzionali (i default vanno bene per M1 / 8GB) ---
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192
# RESEARCH_NUM_RESULTS=5

# --- Modalità map-reduce (default attiva): legge ogni fonte INTERA e la riassume,
#     poi unisce i riassunti. È il modo per leggere articoli interi su 8GB. ---
# RESEARCH_MAP_REDUCE=1
# RESEARCH_MAP_CONTENT_CHARS=6000   # caratteri letti per fonte nel passo "map"

# --- Multi-query: piu' ricerche diverse dalla stessa domanda, unite e deduplicate.
#     Amplia la copertura e supera il tetto di 20 risultati di una sola ricerca.
#     Costo: ogni query e' UNA ricerca Tavily. ---
# RESEARCH_MULTI_QUERY=1
# RESEARCH_NUM_QUERIES=3
# RESEARCH_QUERY_MODIFIERS=2026        # angolazioni aggiunte (default: solo l'anno).
#   Le query sono costruite dalle PAROLE CHIAVE della domanda: stopword ed esche da
#   classifica (migliori/best/top/guida) vengono rimosse per evitare i listicle SEO.
#   I vincoli ("escludi ...") sono separati e usati per la valutazione, non per cercare.

# --- Qualita' delle fonti ---
# RESEARCH_SEARCH_DEPTH=advanced   # ranking/estrazione migliori (2 crediti vs 1)
# RESEARCH_MIN_SCORE=0             # scarta fonti sotto questa rilevanza (0-1)
# RESEARCH_EXCLUDE_DOMAINS=reddit.com,quora.com,x.com,twitter.com,facebook.com,pinterest.com,tripadvisor.com
#   (lascia vuoto "RESEARCH_EXCLUDE_DOMAINS=" per non escludere nulla)
# RESEARCH_FILTER_FORUMS=1         # scarta forum/community via pattern (anche italiani)
# RESEARCH_DROP_IRRELEVANT=1       # butta dalla sintesi le fonti giudicate non pertinenti
# RESEARCH_MAX_PER_DOMAIN=2        # max pagine tenute per singolo dominio (diversità)
# RESEARCH_AUTHORITY_BONUS=0.15    # bonus di score a fonti accademiche/ufficiali (.edu/.gov/enti)

# --- Ricerca bilingue: aggiunge una query tradotta in inglese (fonti piu' ricche
#     e autorevoli su tech/finanza/scienza). Traduzione gratuita via deep-translator. ---
# RESEARCH_BILINGUAL=1

# --- Loop iterativo (il cuore del "deep researcher"): dopo una sintesi, individua le
#     LACUNE e fa ricerche mirate per colmarle, poi rifonde. Piu' round = piu' profondo
#     ma piu' lento (ogni round aggiunge letture e una sintesi). ---
# RESEARCH_MAX_ROUNDS=3            # 1 = singola passata; 3 = iniziale + 2 approfondimenti
# RESEARCH_GAP_QUERIES=2          # quante lacune inseguire per round

# --- Auto-verifica: passo finale che ricontrolla l'analisi contro le fonti raccolte
#     e segnala le affermazioni non supportate (non riscarica nulla, +1 chiamata). ---
# RESEARCH_VERIFY=1

# --- Modalita' accademica: privilegia paper/studi/fonti dense. Si attiva con tag nella
#     domanda (#paper #studi #scientifico ...) o da sola se la domanda contiene segnali
#     accademici (studio, correlazione, meta-analisi, r=, campione...). ---
# RESEARCH_ACADEMIC_BONUS=0.30     # bonus forte ai repository di paper (pubmed, arxiv...)

# --- Consapevolezza temporale: bonus mite alle fonti recenti (quando c'e' la data). ---
# RESEARCH_RECENCY_BONUS=0.10

# --- Cache delle ricerche Tavily: non ripaga query identiche entro il TTL. ---
# RESEARCH_CACHE=1
# RESEARCH_CACHE_TTL_H=24          # ore di validita' della cache

# --- Salvataggio delle ricerche in Markdown (cartella ./ricerche) ---
# RESEARCH_SAVE=1
# RESEARCH_SAVE_DIR=/percorso/personalizzato

# --- Modalità semplice (solo se RESEARCH_MAP_REDUCE=0) ---
# RESEARCH_FULL_CONTENT=0    # 1 = passa il testo pieno in un'unica richiesta
# RESEARCH_CONTENT_CHARS=2500
